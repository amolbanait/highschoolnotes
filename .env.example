# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=

# Change for anything but local development.
HSN_SECRET_KEY=dev-only-change-me
HSN_COOKIE_SECURE=false
HSN_CORS_ORIGINS=["http://localhost:3000"]

# Model and limits (defaults shown).
# HSN_WRITER_MODEL=claude-opus-5-5
# HSN_PLAN_EFFORT=high
# HSN_WRITE_EFFORT=medium
# HSN_GUIDE_TOKEN_BUDGET=600000
# HSN_MAX_UPLOAD_BYTES=20971520
# HSN_MAX_PAGES=60
# HSN_MAX_WORDS=40000

# Recordings, videos, scans and photos (defaults shown).
# HSN_MAX_MEDIA_BYTES=1073741824
# HSN_MAX_MEDIA_MINUTES=120
# HSN_VISION_ENABLED=true
# HSN_VISION_MODEL=claude-sonnet-5-5
# HSN_MAX_VIDEO_FRAMES=60
# HSN_WHISPER_MODEL=small        # tiny, base, small, medium, large-v3
# HSN_WHISPER_DEVICE=cpu         # cuda on a GPU worker
# HSN_WHISPER_COMPUTE_TYPE=int8  # float16 on a GPU worker
